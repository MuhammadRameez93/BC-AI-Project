{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/ensure-env.mjs && prisma migrate deploy",
    "dev": "node scripts/ensure-db.mjs && next dev --turbopack",
    "build": "node scripts/ensure-env.mjs && prisma generate && next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:migrate": "node scripts/ensure-env.mjs && prisma migrate dev",
    "db:setup": "node scripts/ensure-env.mjs && prisma migrate deploy",
    "db:push": "node scripts/ensure-env.mjs && prisma db push"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "jose": "^6.2.4",
    "next": "15.5.21",
    "prisma": "^7.9.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.21",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
